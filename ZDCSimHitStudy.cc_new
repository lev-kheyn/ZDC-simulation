#include "FWCore/Framework/interface/Frameworkfwd.h"
#include "FWCore/Framework/interface/one/EDAnalyzer.h"

#include "FWCore/Framework/interface/Event.h"
#include "FWCore/Framework/interface/EventSetup.h"
#include "FWCore/Framework/interface/MakerMacros.h"

#include "FWCore/ParameterSet/interface/ParameterSet.h"
#include "FWCore/Utilities/interface/InputTag.h"
#include "FWCore/MessageLogger/interface/MessageLogger.h"

#include "FWCore/ServiceRegistry/interface/Service.h"
#include "CommonTools/UtilAlgos/interface/TFileService.h"

#include "DataFormats/HcalDetId/interface/HcalZDCDetId.h"
#include "SimDataFormats/CaloHit/interface/PCaloHit.h"
#include "SimDataFormats/CaloHit/interface/PCaloHitContainer.h"

#include <CLHEP/Units/GlobalPhysicalConstants.h>
#include <CLHEP/Units/SystemOfUnits.h>

#include <TH1F.h>
#include <iostream>
#include "TMath.h"
#include <TROOT.h>
#include <TSystem.h>
#include <TStyle.h>
#include "TFile.h"
#include "TTree.h"
#include <string>
#include <vector>

using namespace std;
using namespace edm;

class ZDCSimHitStudy : public edm::one::EDAnalyzer<edm::one::SharedResources> {
public:
  ZDCSimHitStudy(const edm::ParameterSet &ps);
  ~ZDCSimHitStudy() override = default;
  static void fillDescriptions(edm::ConfigurationDescriptions &descriptions);

protected:
//  void endJob() override {}
  void endJob() override;
  void analyze(const edm::Event &e, const edm::EventSetup &c) override;

  void analyzeHits(const std::vector<PCaloHit> &);

private:
  Service<TFileService> fs;
  TTree* myTree;
  int nhits;
  int hit_section[5000], hit_zside[5000], hit_depth[5000], hit_channel[5000];
  int hit_energy[5000], hit_time[5000];

  const std::string g4Label_;
  const std::string hitLab_;
  const edm::EDGetTokenT<edm::PCaloHitContainer> toks_calo_;
};
//================================================================================================

ZDCSimHitStudy::ZDCSimHitStudy(const edm::ParameterSet &ps)
    : g4Label_(ps.getParameter<std::string>("ModuleLabel")),
      hitLab_(ps.getParameter<std::string>("HitCollection")),
      toks_calo_(consumes<edm::PCaloHitContainer>(edm::InputTag{g4Label_, hitLab_})) {
  usesResource(TFileService::kSharedResource);

  Service<TFileService> fs;
  myTree = fs->make<TTree>("myTree","myTree");

  myTree->Branch("nhits",&nhits, "nhits/I");
  myTree->Branch("hit_section", hit_section, "hit_section[nhits]/I");
  myTree->Branch("hit_zside", hit_zside, "hit_zside[nhits]/I");
  myTree->Branch("hit_depth", hit_depth, "hit_depth[nhits]/I");
  myTree->Branch("hit_channel", hit_channel, "hit_channel[nhits]/I");
  myTree->Branch("hit_energy", hit_energy, "hit_energy[nhits]/I");
  myTree->Branch("hit_time", hit_time, "hit_time[nhits]/I");
}

//================================================================================================
void ZDCSimHitStudy::fillDescriptions(edm::ConfigurationDescriptions &descriptions) {
  edm::ParameterSetDescription desc;
  desc.add<std::string>("ModuleLabel", "g4SimHits");
  desc.add<std::string>("HitCollection", "ZDCHITS");
  descriptions.add("zdcSimHitStudy", desc);
}

void ZDCSimHitStudy::analyze(const edm::Event &e, const edm::EventSetup &) {

  const edm::Handle<edm::PCaloHitContainer> &hitsCalo = e.getHandle(toks_calo_);
  bool getHits = (hitsCalo.isValid());

  std::vector<PCaloHit> zdcHits;
  if (getHits) {
    zdcHits.insert(zdcHits.end(), hitsCalo->begin(), hitsCalo->end());
  }
  analyzeHits(zdcHits);
}

void ZDCSimHitStudy::analyzeHits(const std::vector<PCaloHit> &zdcHits) {
  nhits=zdcHits.size();
  printf("  nhits %5d \n",nhits);     
  cout << "    id       i  Section zside  depth channel     energy      time " << endl;  
  
  for (int i = 0; i < nhits; i++) {
    
    uint32_t id = zdcHits[i].id();
    hit_energy[i]= zdcHits[i].energy  ()*1000;
    hit_time[i] = zdcHits[i].time();
    hit_section[i]=HcalZDCDetId(id).section();   
    hit_zside[i]=HcalZDCDetId(id).zside();   
    hit_depth[i]=HcalZDCDetId(id).depth();   
    hit_channel[i]=HcalZDCDetId(id).channel(); 
    
      cout <<id;										 
      printf("%4d %6d %6d %6d %6d   %8d   %8d  \n",i						     ,HcalZDCDetId(id).section(), HcalZDCDetId(id).zside(), HcalZDCDetId(id).depth()		 
     ,HcalZDCDetId(id).channel(), hit_energy[i], hit_time[i]); 
  }  
  myTree->Fill(); 
}

void ZDCSimHitStudy::endJob() {
}

//define this as a plug-in
DEFINE_FWK_MODULE(ZDCSimHitStudy);
